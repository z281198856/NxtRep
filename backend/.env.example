NXTREP_ENVIRONMENT=local
NXTREP_DEBUG=true
NXTREP_API_V1_PREFIX=/api/v1
NXTREP_DATABASE_URL=postgresql+asyncpg://nxtrep:nxtrep@localhost:5432/nxtrep
NXTREP_OPENAI_API_KEY=
NXTREP_OPENAI_MODEL=gpt-5-mini
NXTREP_CORS_ORIGINS=["http://localhost:3000"]
NXTREP_JWT_SECRET=
NXTREP_ACCESS_TOKEN_EXPIRE_MINUTES=15
NXTREP_REFRESH_TOKEN_EXPIRE_DAYS=30
NXTREP_PASSWORD_SETUP_TOKEN_EXPIRE_MINUTES=30
