# Copy the keys into a server-side secret store or an untracked backend/.env.
# Do not commit real values. Empty required values intentionally prevent go-live.
NXTREP_ENVIRONMENT=production
NXTREP_DEBUG=false
NXTREP_DATABASE_URL=
NXTREP_JWT_SECRET=
# Native mobile clients do not need browser CORS. Add explicit HTTPS web origins if needed.
NXTREP_CORS_ORIGINS=[]

# Set these before enabling AI, RAG and image features for production users.
NXTREP_LLM_PROVIDER=deepseek
NXTREP_DEEPSEEK_API_KEY=
NXTREP_GLM_API_KEY=
NXTREP_RAG_ENABLED=false
# NXTREP_STORAGE_PROVIDER=aliyun_oss
# NXTREP_OSS_REGION=
# NXTREP_OSS_ENDPOINT=
# NXTREP_OSS_BUCKET=
# NXTREP_OSS_ACCESS_KEY_ID=
# NXTREP_OSS_ACCESS_KEY_SECRET=
